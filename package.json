{
  "name": "keyboard-puzzle-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "vp config"
  },
  "dependencies": {
    "@vitest/browser-playwright": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "playwright": "^1.63.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.1",
      "onFail": "download"
    }
  },
  "catalog": {
    "@vitest/browser-playwright": "5.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "5.0.0"
  }
}
